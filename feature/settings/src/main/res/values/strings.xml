    <string name="settings_retention_30_days">Keep for 30 days</string>
    <string name="settings_retention_keep_indefinitely_summary">Nothing is deleted automatically. This is the default.</string>
    <string name="settings_retention_one_year_summary">Data older than 1 year is deleted by the daily cleanup.</string>
    <string name="settings_retention_90_days_summary">Data older than 90 days is deleted by the daily cleanup.</string>
    <string name="settings_retention_30_days_summary">Data older than 30 days is deleted by the daily cleanup.</string>
