    <!-- Data retention -->
    <string name="settings_retention_title">Data retention</string>
    <string name="settings_retention_intro">Choose how long Agentle keeps collected data on this phone: events from the phone and the wearable, and the summaries and features calculated only from them.</string>
    <string name="settings_retention_section_keep">Keep data</string>
