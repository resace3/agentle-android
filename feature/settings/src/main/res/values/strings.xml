    <!-- Background behavior -->
    <string name="settings_background_title">Background behavior</string>
    <string name="settings_background_intro">Agentle collects in short background runs that Android schedules and batches. Nothing runs all the time.</string>
    <string name="settings_background_section_profile">Collection profile</string>
    <string name="settings_profile_low">Low</string>
    <string name="settings_profile_balanced">Balanced</string>
    <string name="settings_profile_high">High detail</string>
    <string name="settings_profile_low_summary">Checks phone usage every 6 hours, syncs the wearable every 6 hours on unmetered networks such as Wi-Fi, and checks JITAIs every hour. Target: about 2 to 3 minutes of background work a day.</string>
    <string name="settings_profile_balanced_summary">Checks phone usage every 2 hours, syncs the wearable every hour, and checks JITAIs every 30 minutes. Target: about 8 minutes of background work a day. Recommended.</string>
    <string name="settings_profile_high_summary">Checks phone usage every 30 minutes, syncs the wearable every 30 minutes, and checks JITAIs every 15 minutes. Target: about 20 minutes of background work a day.</string>
    <string name="settings_background_adapted">Battery Saver has been on for 30 minutes, so %1$s is in force until it has been off for 30 minutes.</string>
    <string name="settings_background_section_saver">Battery Saver</string>
    <string name="settings_background_saver_on">Battery Saver is on</string>
    <string name="settings_background_saver_off">Battery Saver is off</string>
    <string name="settings_background_saver_body">While Battery Saver is on, Agentle does only essential work and cloud syncs wait. If it stays on for 30 minutes, Agentle switches to Low until Battery Saver has been off for 30 minutes.</string>
    <string name="settings_background_section_optimization">Battery optimization</string>
    <string name="settings_background_optimized">Battery optimization is on (recommended)</string>
    <string name="settings_background_unrestricted">Battery usage is set to Unrestricted</string>
    <string name="settings_background_optimization_unknown">The battery optimization status couldn’t be read</string>
    <string name="settings_background_optimization_body">Agentle is designed to work with battery optimization and never asks you to turn it off. If you want to change it, use Agentle’s page in system settings.</string>
    <string name="settings_background_restricted_title">Background activity is restricted</string>
    <string name="settings_background_restricted_body">Android stops Agentle’s background work, so data is collected only while Agentle is open. You can allow background activity on Agentle’s page in system settings.</string>
    <string name="settings_background_bucket">App standby bucket: %1$s</string>
    <string name="settings_background_bucket_low_body">In this bucket Android runs Agentle’s background work less often. Opening Agentle moves it up again.</string>
