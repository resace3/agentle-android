    <string name="settings_retention_section_when">When data is deleted</string>
    <string name="settings_retention_when_body">A cleanup runs once a day in the background and deletes data older than the chosen period. After that, syncs and imports can’t bring the deleted period back. Choosing a longer period later doesn’t restore deleted data.</string>
