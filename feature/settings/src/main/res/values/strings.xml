    <!-- Privacy -->
    <string name="settings_privacy_title">Privacy</string>
    <string name="settings_privacy_section_stored">Stored on this phone</string>
    <string name="settings_privacy_db_encrypted">Your data is in an encrypted database.</string>
    <string name="settings_privacy_db_not_encrypted">The database is not encrypted.</string>
    <string name="settings_privacy_db_unknown">Database encryption couldn’t be checked.</string>
    <string name="settings_privacy_stored_local">Collected data, insights and JITAIs are stored only in Agentle’s private storage on this phone.</string>
    <string name="settings_privacy_stored_tokens">ChatGPT sign-in tokens are kept in a vault encrypted with a key from Android Keystore. Google sign-in is handled by Google Play services, and Agentle stores no Google token.</string>
    <string name="settings_privacy_stored_media">Generated images, voice files and videos stay in Agentle’s private storage.</string>
    <string name="settings_privacy_stored_backup">Nothing is included in Android backups or device-to-device transfers.</string>
    <string name="settings_privacy_section_never">Never leaves this phone</string>
    <string name="settings_privacy_never_events">Raw events, such as app usage, screen time, calendar entries and device state</string>
    <string name="settings_privacy_never_notifications">The text of other apps’ notifications</string>
